{
  "name": "pokopia-companion",
  "version": "0.1.0",
  "private": true,
  "packageManager": "npm@10.9.8",
  "engines": {
    "node": ">=22.0.0"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo dev",
    "dev:web": "npm run dev --workspace @pokopia/web",
    "dev:admin": "npm run dev --workspace @pokopia/admin",
    "build": "turbo build",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "turbo typecheck",
    "test": "turbo test",
    "test:e2e": "playwright test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "data:audit": "npm run audit --workspace @pokopia/ingestion",
    "data:process": "npm run process --workspace @pokopia/ingestion",
    "data:validate": "npm run validate --workspace @pokopia/ingestion",
    "data:verify-source": "node scripts/verify-source-integrity.mjs",
    "data:verify-master": "node scripts/verify-source-integrity.mjs",
    "audit:review-data": "node scripts/run-review-audit.mjs",
    "audit:review-data:generate": "tsx scripts/generate-review-audit.ts",
    "audit:review-security": "node scripts/generate-review-security.mjs",
    "security:env": "tsx scripts/validate-environment.ts",
    "security:test": "npm test --workspace @pokopia/security && npm test --workspace @pokopia/admin && npm test --workspace @pokopia/web && npm test --workspace @pokopia/db && node scripts/verify-security-regressions.mjs",
    "evidence:verify": "node scripts/verify-evidence-integrity.mjs",
    "benchmark:core": "tsx scripts/benchmark-core.ts",
    "audit:iteration-5": "tsx scripts/generate-iteration-5-audit.ts",
    "audit:iteration-5-1": "tsx scripts/generate-iteration-5-1-audit.ts",
    "audit:iteration-5-5": "tsx scripts/generate-iteration-5-5-audit.ts",
    "measurement:validate": "tsx scripts/validate-gameplay-measurement.ts",
    "archive:iteration-5-1": "node scripts/create-iteration-5-1-archive.mjs",
    "archive:iteration-5-5": "node scripts/create-iteration-5-5-archive.mjs",
    "data:seed": "npm run seed --workspace @pokopia/db",
    "db:seed": "npm run seed --workspace @pokopia/db",
    "db:seed:dry": "npm run seed:dry --workspace @pokopia/db",
    "db:validate": "npm run validate --workspace @pokopia/db",
    "db:migrate": "npm run migrate --workspace @pokopia/db"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "@types/node": "22.20.1",
    "@eslint/js": "9.39.5",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.0",
    "globals": "17.9.0",
    "prettier": "3.9.6",
    "tsx": "4.23.11",
    "turbo": "2.10.9",
    "typescript": "5.8.3",
    "typescript-eslint": "8.66.0",
    "vitest": "3.2.4"
  }
}
