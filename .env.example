# Portable PostgreSQL connection used by scripts and server-only application code.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
POKOPIA_DEPLOYMENT_TARGET=development
POKOPIA_PUBLIC_ORIGIN=http://localhost:3000

# Explicit runtime backend: sqlite (offline/review/test) or postgres (canonical server runtime).
POKOPIA_DATA_BACKEND=sqlite
POKOPIA_DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# Optional Supabase integration. Never expose a service-role/secret key.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# Distributed rate limiting. `memory` is local/test only; production must use postgres.
POKOPIA_RATE_LIMIT_BACKEND=memory
POKOPIA_RATE_LIMIT_DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
POKOPIA_RATE_LIMIT_KEY_SECRET=

# Forwarded client headers are ignored unless this explicit trusted-proxy contract is enabled.
# Vercel deployments use the platform identity header when VERCEL=1.
POKOPIA_TRUST_PROXY_HEADERS=false

# Local generated-data fallback used when PostgreSQL is unavailable.
POKOPIA_CANONICAL_DIR=../../data/canonical
POKOPIA_DATABASE_PATH=./data/canonical/v3.1/pokopia-canonical.sqlite

# Comma-separated Supabase user UUIDs allowed into the admin app.
POKOPIA_ADMIN_AUTH_MODE=local-password
POKOPIA_ADMIN_USER_IDS=

# Local/private admin fallback. Use a long unique password and at least 32 random bytes for the secret.
POKOPIA_ADMIN_PASSWORD=
POKOPIA_ADMIN_SESSION_SECRET=
